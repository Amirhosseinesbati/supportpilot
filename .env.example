# Copy to .env in the project root for Docker Compose, then fill the three
# required values. For direct API execution, copy to apps/api/.env and also
# set DATABASE_URL to a PostgreSQL URL.
# Do not reuse the synthetic demo password or this example for a customer.
APP_MODE=CONNECTED
POSTGRES_DB=supportpilot
POSTGRES_USER=supportpilot
# Use a long URL-safe random value; Compose also inserts it into DATABASE_URL.
POSTGRES_PASSWORD=
SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Maximum output tokens for the one model request per CONNECTED chat run.
MODEL_MAX_OUTPUT_TOKENS=700
# Maximum characters in the model's question/order/evidence input and each passage.
MODEL_MAX_INPUT_CHARS=16000
MODEL_MAX_PASSAGE_CHARS=1000
COOKIE_SECURE=false
REFERENCE_DATE=2026-09-27
MAX_UPLOAD_BYTES=10485760

# Optional live connectors. Local adapters remain available in CONNECTED mode.
COMMERCE_ADAPTER=local
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
SUPPORT_ADAPTER=local
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Required for direct API execution outside Compose. Compose and the local
# DEMO scripts override it with their configured database URL.
DATABASE_URL=
# UPLOAD_ROOT=./data/uploads
